@article{pellicer-5-politopo,
title = {A chiral 5-polytope of full rank},
journal = {Discrete Mathematics},
volume = {344},
number = {6},
pages = {112370},
year = {2021},
issn = {0012-365X},
doi = {https://doi.org/10.1016/j.disc.2021.112370},
url = {https://www.sciencedirect.com/science/article/pii/S0012365X21000832},
author = {Pellicer, D.},
keywords = {Chiral polyhedron, Chiral 5-polytope, Abstract polytope, Polytope of full rank},
abstract = {The first chiral polytope of full rank known was Roli’s cube, a rank 4 polytope discovered in 2014. Since then, other chiral polytopes of rank 4 have been studied. Here we present the first known chiral 5-polytope of full rank. Its 2-skeleton is the same as that of the Euclidean tessellation {3,4,3,3} with 24-cells.}
}

